# Application
APP_NAME=Industrial Safety AI Platform
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# HTTP API
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
API_AUTH_ENABLED=false
# Required when API_AUTH_ENABLED=true. Never commit the real key.
API_KEY=
API_RATE_LIMIT=30
API_RATE_WINDOW_SECONDS=60
API_INFERENCE_TIMEOUT_SECONDS=300
# Dashboard-only request timeout in seconds.
API_REQUEST_TIMEOUT_SECONDS=300
API_MAX_IMAGE_BYTES=20000000
API_MAX_VIDEO_BYTES=500000000
API_MAX_VIDEO_FRAMES=10000
API_EVENT_LOG_PATH=runs/inference/events.db

# Vision (Phase 2)
# Choose exactly one source before running safety-vision:
# VISION_SOURCE=0
# VISION_SOURCE=C:\\path\\to\\video.mp4
VISION_PERSON_MODEL=yolo11n.pt
VISION_TRACKER=bytetrack.yaml
VISION_CONFIDENCE=0.35
VISION_IOU_THRESHOLD=0.45
VISION_DISPLAY=true
VISION_WINDOW_NAME=Industrial Safety AI - Phase 2
VISION_PPE_MIN_CONFIDENCE=0.25
VISION_ASSOCIATION_MIN_CONTAINMENT=0.20

# Optional. The API defaults to best.pt at the repository root.
# MODEL_PATH=best.pt
# Backward-compatible alias for MODEL_PATH.
# VISION_PPE_MODEL=best.pt
# JSON mapping from the PPE model's labels to the canonical PPE classes.
# VISION_PPE_CLASS_MAP={"helmet":"helmet","vest":"vest","boots":"shoes"}
